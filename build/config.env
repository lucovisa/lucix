# Настройки сборки Lucix. Любую переменную можно переопределить из окружения.
LUCIX_NAME="${LUCIX_NAME:-Lucix}"
LUCIX_STAGE="${LUCIX_STAGE:-alpha}"

UBUNTU_VERSION="${UBUNTU_VERSION:-26.04}"
UBUNTU_SUITE="${UBUNTU_SUITE:-resolute}"
UBUNTU_MIRROR="${UBUNTU_MIRROR:-http://archive.ubuntu.com/ubuntu}"
UBUNTU_SECURITY_MIRROR="${UBUNTU_SECURITY_MIRROR:-http://security.ubuntu.com/ubuntu}"
ARCH="${ARCH:-amd64}"
