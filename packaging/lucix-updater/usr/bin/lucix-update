def t(key):
    return TEXT[key][1 if RU else 0]


CATALOG = "/usr/share/lucix/apps.json"
STATE = "/var/lib/lucix/apps.json"


def load_catalog():
    try:
        with open(CATALOG, encoding="utf-8") as f:
            return json.load(f)["apps"]
    except Exception:
        return []


def read_installed():
    try:
        with open(STATE, encoding="utf-8") as f:
            return set(json.load(f).get("installed", []))
    except Exception:
        return set()


FEATURES = "/usr/share/lucix/features.json"
GRUB_MARK = "/var/lib/lucix/grub-theme"
GRUB_THEME_TXT = "/boot/grub/themes/minegrub-world-selection/theme.txt"


def load_features():
    try:
        with open(FEATURES, encoding="utf-8") as f:
            return json.load(f)["features"]
    except Exception:
        return []


def security_state(fid):
    if fid == "autoupdates":
        try:
            with open("/etc/apt/apt.conf.d/52lucix-auto-security", encoding="utf-8") as f:
                return apt_installed(["unattended-upgrades"]) and 'Unattended-Upgrade "1"' in f.read()
        except OSError:
            return False
    if fid == "apparmor":
        r = subprocess.run(["systemctl", "is-enabled", "apparmor"], capture_output=True, text=True)
        return apt_installed(["apparmor"]) and r.stdout.strip() == "enabled"
    if fid == "ufw":
        try:
            with open("/etc/ufw/ufw.conf", encoding="utf-8") as f:
                return apt_installed(["ufw"]) and "ENABLED=yes" in f.read()
        except OSError:
            return False
    return False


def human_size(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return ("%d %s" % (n, unit)) if unit == "B" else ("%.1f %s" % (n, unit))
        n /= 1024


def apt_installed(pkgs):
    for pkg in pkgs:
        r = subprocess.run(["dpkg-query", "-W", "-f=${Status}", pkg], capture_output=True, text=True)
        if "install ok installed" not in r.stdout:
            return False
    return True


def grub_state():
    """on / off / removed"""
    try:
        with open(GRUB_MARK, encoding="utf-8") as f:
            mark = f.read().strip()
    except OSError:
        mark = ""
    if mark in ("off", "removed"):
        return mark
    return "on" if os.path.isfile(GRUB_THEME_TXT) else "removed"


def load_helper():
    """логику дисков берём из хелпера, чтобы она была в одном месте"""
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader("lucix_helper", HELPER)
    spec = importlib.util.spec_from_loader("lucix_helper", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


try:
    H = load_helper()
except Exception:
    H = None


VISUAL_DB = os.path.join(os.path.expanduser("~"), ".local", "share", "lucix", "visual.json")
PLACES = os.path.join(os.path.expanduser("~"), ".local", "share", "user-places.xbel")


def vis_load():
    try:
        with open(VISUAL_DB, encoding="utf-8") as f:
            db = json.load(f)
    except (OSError, ValueError):
        db = {}
    db.setdefault("folders", {})
    db.setdefault("xattrs", {})
    return db


def vis_save(db):
    os.makedirs(os.path.dirname(VISUAL_DB), exist_ok=True)
    with open(VISUAL_DB, "w", encoding="utf-8") as f:
        json.dump(db, f, ensure_ascii=False, indent=1)


def dir_read_keys(folder, keys=("Name", "Icon")):
    """значения Name и Icon из .directory (None, если не заданы)"""
    out = {k: None for k in keys}
    try:
        with open(os.path.join(folder, ".directory"), encoding="utf-8") as f:
            sec = None
            for line in f:
                st = line.strip()
                if st.startswith("[") and st.endswith("]"):
                    sec = st[1:-1]
                elif sec == "Desktop Entry":
                    for k in keys:
                        if st.startswith(k + "="):
                            out[k] = st[len(k) + 1:]
    except OSError:
        pass
    return out


def dir_write_keys(folder, values):
    """пишет ключи (Name, Icon) в .directory, None удаляет ключ; пустой файл удаляется"""
    path = os.path.join(folder, ".directory")
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        lines = []
    new = [k + "=" + v for k, v in values.items() if v]
    out, sec, inserted = [], None, False
    for line in lines:
        st = line.strip()
        if st.startswith("[") and st.endswith("]"):
            if sec == "Desktop Entry" and not inserted:
                out += new
                inserted = True
            sec = st[1:-1]
        elif sec == "Desktop Entry" and any(st.startswith(k + "=") or st.startswith(k + "[") for k in values):
            continue
        out.append(line)
    if sec == "Desktop Entry" and not inserted:
        out += new
        inserted = True
    if new and not inserted:
        out = ["[Desktop Entry]"] + new + out
    if not [l for l in out if l.strip() and l.strip() != "[Desktop Entry]"]:
        if os.path.exists(path):
            os.remove(path)
        return
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")


def xattr_get(path, attr):
    try:
        return os.getxattr(path, attr).decode("utf-8", "replace")
    except OSError:
        return None


def xattr_set(path, attr, value):
    if value is None:
        try:
            os.removexattr(path, attr)
        except OSError:
            pass
        return
    os.setxattr(path, attr, value.encode("utf-8"))


def vis_restore(db, path):
    """возвращает папку или файл как было до изменений"""
    saved = db["folders"].pop(path, None)
    if saved is not None and os.path.isdir(path):
        try:
            dir_write_keys(path, saved)
        except OSError:
            pass
    for attr, value in (db["xattrs"].pop(path, None) or {}).items():
        try:
            xattr_set(path, attr, value)
        except OSError:
            pass


def places_add(folder, label, icon):
    """пункт в боковой панели Dolphin с любым текстом и значком (только отображение)"""
    from urllib.parse import quote
    from xml.sax.saxutils import escape
    try:
        with open(PLACES, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return False
    if "</xbel>" not in text:
        return False
    block = ('<bookmark href="file://%s">\n <title>%s</title>\n <info>\n  <metadata owner="http://freedesktop.org">\n'
             '   <bookmark:icon name="%s"/>\n  </metadata>\n  <metadata owner="http://www.kde.org">\n'
             '   <ID>lucix-%d</ID>\n   <isSystemItem>false</isSystemItem>\n  </metadata>\n </info>\n</bookmark>\n'
             % (quote(folder), escape(label), escape(icon, {'"': "&quot;"}), int(time.time() * 1000)))
    shutil.copy2(PLACES, PLACES + ".lucix-bak")
    with open(PLACES, "w", encoding="utf-8") as f:
        f.write(text.replace("</xbel>", block + "</xbel>"))
    return True


def places_clear():
    import re as _re
    try:
        with open(PLACES, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return
    new = _re.sub(r'<bookmark href="[^"]*">(?:(?!</bookmark>).)*?<ID>lucix-\d+</ID>(?:(?!</bookmark>).)*?</bookmark>\s*', "",
                  text, flags=_re.S)
    if new != text:
        with open(PLACES, "w", encoding="utf-8") as f:
            f.write(new)


def deb_version(tag):
    return tag.lstrip("v").replace("-", "~")


def installed_version():
    r = subprocess.run(["dpkg-query", "-W", "-f=${Version}", "lucix-base"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def is_newer(new, cur):
    if not cur:
        return True
    return subprocess.run(["dpkg", "--compare-versions", new, "gt", cur]).returncode == 0


def fetch_releases():
    url = "https://api.github.com/repos/%s/releases?per_page=15" % REPO
    req = urllib.request.Request(url, headers={"User-Agent": "lucix-update", "Accept": "application/vnd.github+json"})
    with urllib.request.urlopen(req, timeout=20) as r:
        data = json.load(r)
    result = []
    for rel in data:
        if rel.get("draft"):
            continue
        names = [a["name"] for a in rel.get("assets", [])]
        if "SHA256SUMS" in names:
            result.append(rel)
    return result


class Updater(Gtk.Window):
    def __init__(self):
        super().__init__(title=app_title())
        self.set_default_size(780, 640)
        self.set_icon_name("lucix")
        self.releases = []
        self.busy_widgets = []
        self.feat_buttons = []
        self.live_locked = []

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        root.set_border_width(10)
        self.add(root)

        notebook = Gtk.Notebook()
        root.pack_start(notebook, True, True, 0)
        notebook.append_page(self.build_lucix_tab(), Gtk.Label(label=t("tab_lucix")))
        notebook.append_page(self.build_apps_tab(), Gtk.Label(label=t("tab_apps")))
        notebook.append_page(self.build_features_tab(), Gtk.Label(label=t("tab_features")))
        notebook.append_page(self.build_memory_tab(), Gtk.Label(label=t("tab_memory")))
        notebook.append_page(self.build_disks_tab(), Gtk.Label(label=t("tab_disks")))
        notebook.append_page(self.build_visual_tab(), Gtk.Label(label=t("tab_visual")))
        notebook.append_page(self.build_system_tab(), Gtk.Label(label=t("tab_system")))
        notebook.append_page(self.build_drivers_tab(), Gtk.Label(label=t("tab_drivers")))

        self.log = Gtk.TextView()
        self.log.set_editable(False)
        self.log.set_monospace(True)
        self.log.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        scroll = Gtk.ScrolledWindow()
        scroll.set_min_content_height(170)
        scroll.add(self.log)
        root.pack_start(scroll, False, True, 0)

        self.connect("destroy", Gtk.main_quit)
        self.show_all()
        self.refresh_installed()
        self.check_lucix()
        self.load_drivers()

    #вкладка lucix
    def build_lucix_tab(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(8)

        self.installed_label = Gtk.Label(xalign=0)
        box.pack_start(self.installed_label, False, False, 0)

        row = Gtk.Box(spacing=8)
        self.test_check = Gtk.CheckButton(label=t("show_test"))
        self.test_check.set_active(SHOW_TEST_DEFAULT)
        self.test_check.connect("toggled", lambda *_: self.check_lucix())
        row.pack_start(self.test_check, False, False, 0)
        self.check_btn = Gtk.Button(label=t("check"))
        self.check_btn.connect("clicked", lambda *_: self.check_lucix())
        row.pack_end(self.check_btn, False, False, 0)
        box.pack_start(row, False, False, 0)

        self.status_label = Gtk.Label(xalign=0)
        box.pack_start(self.status_label, False, False, 0)

        self.store = Gtk.ListStore(str, str, str)
        self.tree = Gtk.TreeView(model=self.store)
        for i, key in enumerate(("col_version", "col_date", "col_type")):
            self.tree.append_column(Gtk.TreeViewColumn(t(key), Gtk.CellRendererText(), text=i))
        self.tree.get_selection().connect("changed", self.on_select)
        scroll = Gtk.ScrolledWindow()
        scroll.set_min_content_height(130)
        scroll.add(self.tree)
        box.pack_start(scroll, True, True, 0)

        self.notes = Gtk.TextView()
        self.notes.set_editable(False)
        self.notes.set_wrap_mode(Gtk.WrapMode.WORD)
        nscroll = Gtk.ScrolledWindow()
        nscroll.set_min_content_height(110)
        nscroll.add(self.notes)
        box.pack_start(nscroll, True, True, 0)

        self.install_btn = Gtk.Button(label=t("install"))
        self.install_btn.set_sensitive(False)
        self.install_btn.connect("clicked", self.install_selected)
        box.pack_start(self.install_btn, False, False, 0)
        self.busy_widgets += [self.check_btn, self.install_btn]
        return box

    #вкладка приложения
    def build_apps_tab(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(8)
        box.pack_start(Gtk.Label(label=t("live_note") if IS_LIVE else t("apps_note"), xalign=0), False, False, 0)
        self.apps_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        scroll = Gtk.ScrolledWindow()
        scroll.set_min_content_height(200)
        scroll.add(self.apps_box)
        box.pack_start(scroll, True, True, 0)
        btn = Gtk.Button(label=t("apps_install"))
        btn.connect("clicked", self.install_apps)
        box.pack_start(btn, False, False, 0)
        self.busy_widgets.append(btn)
        if IS_LIVE:
            self.live_locked.append(btn)
            btn.set_sensitive(False)
        self.app_checks = {}
        self.refresh_apps()
        return box

    def refresh_apps(self):
        for child in self.apps_box.get_children():
            self.apps_box.remove(child)
        self.app_checks = {}
        installed = read_installed()
        idx = 1 if RU else 0
        for app in load_catalog():
            label = app["name"][idx]
            if app["desc"][idx]:
                label += " - " + app["desc"][idx]
            if app["id"] in installed:
                row = Gtk.Label(label="\u2713 " + label, xalign=0)
            else:
                row = Gtk.CheckButton(label=label)
                row.set_active(app.get("default", False))
                self.app_checks[app["id"]] = row
            self.apps_box.pack_start(row, False, False, 0)
        self.apps_box.show_all()

    def install_apps(self, *_):
        ids = [i for i, c in self.app_checks.items() if c.get_active()]
        if ids:
            self.run_helper(["apps-install", ",".join(ids)])

    #вкладка функции
    def build_features_tab(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(8)
        box.pack_start(Gtk.Label(label=t("live_note") if IS_LIVE else t("feat_note"), xalign=0), False, False, 0)
        self.feat_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        scroll = Gtk.ScrolledWindow()
        scroll.set_min_content_height(200)
        scroll.add(self.feat_box)
        box.pack_start(scroll, True, True, 0)
        self.refresh_features()
        return box

    def refresh_features(self):
        for child in self.feat_box.get_children():
            self.feat_box.remove(child)
        self.feat_buttons = []
        idx = 1 if RU else 0
        for feat in load_features():
            row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            name = feat["name"][idx]
            if feat["kind"] == "security":
                on = security_state(feat["id"])
                state = t("st_on") if on else t("st_off")
                buttons = [(t("f_off") if on else t("f_on"), ["security", feat["id"], "off" if on else "on"], None)]
            elif feat["kind"] == "apt":
                state = t("st_installed") if apt_installed(feat["packages"]) else t("st_not_installed")
                buttons = ([(t("f_remove"), ["feature-apt", "remove", feat["id"]], name)] if apt_installed(feat["packages"])
                           else [(t("f_install"), ["feature-apt", "install", feat["id"]], None)])
            else:
                st = grub_state()
                state = t("st_" + st)
                gid = feat["id"]
                buttons = []
                if st == "on":
                    buttons.append((t("f_off"), ["grub-theme", "off"], None))
                elif st == "off":
                    buttons.append((t("f_on"), ["grub-theme", "on"], None))
                if st in ("on", "off"):
                    buttons.append((t("f_remove"), ["grub-theme", "remove"], name))
                    buttons.append((t("f_redownload"), ["grub-theme", "download"], None))
                else:
                    buttons.append((t("f_download_on"), ["grub-theme", "download"], None))
            title = Gtk.Label(xalign=0)
            title.set_markup("<b>%s</b> - %s" % (GLib.markup_escape_text(name), GLib.markup_escape_text(state)))
            desc = Gtk.Label(label=feat["desc"][idx], xalign=0)
            desc.set_line_wrap(True)
            desc.set_selectable(True)
            row.pack_start(title, False, False, 0)
            row.pack_start(desc, False, False, 0)
            bar = Gtk.Box(spacing=6)
            for label, args, confirm in buttons:
                btn = Gtk.Button(label=label)
                btn.connect("clicked", self.on_feature_button, args, confirm)
                if IS_LIVE:
                    btn.set_sensitive(False)
                bar.pack_start(btn, False, False, 0)
                self.feat_buttons.append(btn)
            if feat.get("launch"):
                cp = Gtk.Button(label=t("copy_launch"))
                cp.connect("clicked", self.copy_text, feat["launch"])
                bar.pack_start(cp, False, False, 0)
            row.pack_start(bar, False, False, 0)
            self.feat_box.pack_start(row, False, False, 0)
        self.feat_box.show_all()

    def copy_text(self, _btn, text):
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(text, -1)
        self.append_log(t("copied") % text)

    def on_feature_button(self, _btn, args, confirm):
        if confirm:
            dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                       buttons=Gtk.ButtonsType.YES_NO, text=t("confirm_remove") % confirm)
            answer = dialog.run()
            dialog.destroy()
            if answer != Gtk.ResponseType.YES:
                return
        self.run_helper(args)

    #вкладка память
    def build_memory_tab(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(8)
        note = Gtk.Label(label=t("mem_note"), xalign=0)
        note.set_line_wrap(True)
        box.pack_start(note, False, False, 0)
        # имя, тип, размер, занято (%), текст занято, свободно, подключён, устройство, подключён ли (bool)
        self.mem_store = Gtk.TreeStore(str, str, str, int, str, str, str, str, bool)
        view = Gtk.TreeView(model=self.mem_store)
        self.mem_view = view
        cols = t("mem_cols")
        for i, title in enumerate(cols):
            if title == cols[3]:
                col = Gtk.TreeViewColumn(title, Gtk.CellRendererProgress(), value=3, text=4)
            else:
                idx = {0: 0, 1: 1, 2: 2, 4: 5, 5: 6}[i]
                col = Gtk.TreeViewColumn(title, Gtk.CellRendererText(), text=idx)
            col.set_resizable(True)
            view.append_column(col)
        scroll = Gtk.ScrolledWindow()
        scroll.set_min_content_height(220)
        scroll.add(view)
        box.pack_start(scroll, True, True, 0)
        bar = Gtk.Box(spacing=6)
        refresh = Gtk.Button(label=t("mem_refresh"))
        refresh.connect("clicked", lambda *_: self.refresh_memory())
        look = Gtk.Button(label=t("mem_view"))
        look.connect("clicked", self.view_volume)
        self.opt_btn = Gtk.Button(label=t("mem_optimize"))
        self.opt_btn.connect("clicked", lambda *_: self.run_helper(["optimize-disks"]))
        for w in (refresh, look, self.opt_btn):
            bar.pack_start(w, False, False, 0)
        self.busy_widgets += [refresh, look, self.opt_btn]
        if IS_LIVE:
            self.live_locked.append(self.opt_btn)
            self.opt_btn.set_sensitive(False)
        box.pack_start(bar, False, False, 0)
        opt = Gtk.Label(label=t("mem_opt_note"), xalign=0)
        opt.set_line_wrap(True)
        box.pack_start(opt, False, False, 0)
        self.refresh_memory()
        return box

    def refresh_memory(self):
        self.mem_store.clear()
        if H is None:
            return
        try:
            tree = H.lsblk_tree()
        except Exception:
            return

        def add(parent, node):
            kind = node.get("type")
            if kind in ("loop", "rom"):
                return
            size = H.to_int(node.get("size"))
            mounts = [m for m in (node.get("mountpoints") or []) if m]
            mnt = mounts[0] if mounts else ""
            used_pct, used_txt, free_txt = 0, "", ""
            if mnt and mnt.startswith("/"):
                try:
                    u = shutil.disk_usage(mnt)
                    used_pct = int(u.used * 100 / u.total) if u.total else 0
                    used_txt = "%s (%d%%)" % (human_size(u.used), used_pct)
                    free_txt = human_size(u.free)
                except OSError:
                    pass
            if kind == "disk":
                name = "%s  %s" % (node.get("path"), node.get("model") or "")
                info = "disk"
            else:
                name = "%s  %s" % (node.get("path") or node.get("name"), node.get("label") or "")
                info = node.get("fstype") or kind or ""
            row = self.mem_store.append(parent, [name.strip(), info, human_size(size), used_pct, used_txt, free_txt,
                                                  mnt, node.get("path") or "", bool(mnt)])
            for child in node.get("children") or []:
                add(row, child)

        for disk in tree:
            add(None, disk)
        self.mem_view.expand_all()

    def helper_sync(self, args):
        p = subprocess.run(["pkexec", HELPER] + args, capture_output=True, text=True)
        return p.returncode, p.stdout

    def view_volume(self, *_):
        model, it = self.mem_view.get_selection().get_selected()
        if it is None:
            self.append_log(t("mem_pick"))
            return
        dev, mnt, mounted, info = model[it][7], model[it][6], model[it][8], model[it][1]
        mounted_here = False
        if not mounted or not mnt.startswith("/"):
            if info in ("disk", "", "crypto_LUKS", "BitLocker", "swap") or not dev:
                self.append_log(t("mem_cant"))
                return
            rc, out = self.helper_sync(["disk-view-mount", dev])
            line = [l for l in out.splitlines() if l.startswith("MOUNT ")]
            if rc != 0 or not line:
                self.append_log(t("mem_mountfail"))
                return
            mnt = line[0][6:]
            mounted_here = True
        self.show_browser(mnt, model[it][0])
        if mounted_here:
            self.helper_sync(["disk-view-umount", dev])

    def show_browser(self, root, title):
        """проводник только для чтения: можно раскрывать папки и смотреть, больше ничего"""
        dialog = Gtk.Dialog(title=title, transient_for=self, modal=True)
        dialog.set_default_size(720, 520)
        store = Gtk.TreeStore(str, str, str, str)  # имя, размер, дата, путь
        view = Gtk.TreeView(model=store)
        for i, name in enumerate(t("mem_browser_cols")):
            col = Gtk.TreeViewColumn(name, Gtk.CellRendererText(), text=i)
            col.set_resizable(True)
            view.append_column(col)

        def fill(parent, path):
            try:
                entries = sorted(os.scandir(path), key=lambda e: (not e.is_dir(follow_symlinks=False), e.name.lower()))
            except OSError:
                store.append(parent, [t("mem_noaccess"), "", "", ""])
                return
            for count, e in enumerate(entries):
                if count >= 5000:
                    store.append(parent, [t("mem_more"), "", "", ""])
                    break
                try:
                    st = e.stat(follow_symlinks=False)
                    isdir = e.is_dir(follow_symlinks=False)
                    size = "" if isdir else human_size(st.st_size)
                    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(st.st_mtime))
                except OSError:
                    isdir, size, when = False, "", ""
                row = store.append(parent, [e.name, size, when, e.path])
                if isdir:
                    store.append(row, ["", "", "", ""])  # заглушка: раскроется при открытии

        def expanded(_view, it, _path):
            first = store.iter_children(it)
            if first is not None and store[first][3] == "" and store[first][0] == "":
                store.remove(first)
                fill(it, store[it][3])

        view.connect("row-expanded", expanded)
        fill(None, root)
        scroll = Gtk.ScrolledWindow()
        scroll.add(view)
        area = dialog.get_content_area()
        area.pack_start(scroll, True, True, 0)
        dialog.add_button("Close" if not RU else "Закрыть", Gtk.ResponseType.CLOSE)
        dialog.show_all()
        dialog.run()
        dialog.destroy()

    #вкладка диски
    def build_disks_tab(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(8)
        note = Gtk.Label(label=t("live_note") if IS_LIVE else t("disks_note"), xalign=0)
        note.set_line_wrap(True)
        box.pack_start(note, False, False, 0)
        self.disks_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        scroll = Gtk.ScrolledWindow()
        scroll.set_min_content_height(200)
        scroll.add(self.disks_box)
        box.pack_start(scroll, True, True, 0)
        self.disk_checks = {}
        self.disk_tree = []
        refresh = Gtk.Button(label=t("disks_refresh"))
        refresh.connect("clicked", lambda *_: self.refresh_disks())
        self.keep_chk = Gtk.CheckButton(label=t("disks_keep"))
        self.disk_btn = Gtk.Button(label=t("disks_btn"))
        self.disk_btn.connect("clicked", self.format_disks)
        box.pack_start(self.keep_chk, False, False, 0)
        box.pack_start(refresh, False, False, 0)
        box.pack_start(self.disk_btn, False, False, 0)
        self.busy_widgets += [refresh, self.disk_btn]
        if IS_LIVE or H is None:
            self.live_locked.append(self.disk_btn)
            self.disk_btn.set_sensitive(False)
        self.refresh_disks()
        return box

    def refresh_disks(self):
        for child in self.disks_box.get_children():
            self.disks_box.remove(child)
        self.disk_checks = {}
        self.disk_tree = []
        if H is not None:
            try:
                self.disk_tree = H.lsblk_tree()
            except Exception:
                self.disk_tree = []
        root = H.find_root(self.disk_tree) if H is not None else None
        if root is None and H is not None:
            for disk in self.disk_tree:  # корень на LVM и т.п.: диск всё равно найдём
                if disk.get("type") == "disk" and any("/" in H.node_mounts(p) for p in disk.get("children") or []):
                    root = {"disk": disk, "part": None}
        if root is None:
            self.disks_box.pack_start(Gtk.Label(label=t("disks_nolucix"), xalign=0), False, False, 0)
            self.disks_box.show_all()
            return
        disk = root["disk"]
        title = "%s  %s  %.0f GB" % (disk["path"], disk.get("model") or "", H.to_int(disk.get("size")) / 1e9)
        head = Gtk.Label(xalign=0)
        head.set_markup("<b>%s</b>" % GLib.markup_escape_text(t("disks_lucix") % title))
        self.disks_box.pack_start(head, False, False, 4)
        cands, attached = [], []
        for node in sorted([p for p in (disk.get("children") or []) if p.get("type") == "part"],
                           key=lambda n: H.to_int(n.get("start"))):
            mounts = [m for m in H.node_mounts(node) if m.startswith(H.DISKS_DIR + "/")]
            if mounts:
                attached.append((node, mounts[0]))
            elif not H.part_protected(node):
                cands.append(node)
        for node in cands:
            fs = node.get("fstype") or "?"
            extra = " [%s]" % t("disks_win") if fs in ("ntfs", "BitLocker") else ""
            label = "%s  -  %.1f GB  -  %s%s  %s" % (node["path"], H.to_int(node.get("size")) / 1e9, fs, extra,
                                                   node.get("label") or "")
            chk = Gtk.CheckButton(label=label)
            self.disk_checks[node["path"]] = chk
            self.disks_box.pack_start(chk, False, False, 0)
        if not cands:
            self.disks_box.pack_start(Gtk.Label(label=t("disks_none"), xalign=0), False, False, 0)
        self.keep_chk.set_visible(bool(cands))
        if attached:
            sub = Gtk.Label(xalign=0)
            sub.set_markup("<b>%s</b>" % GLib.markup_escape_text(t("disks_attached")))
            self.disks_box.pack_start(sub, False, False, 8)
            for node, mnt in attached:
                row = Gtk.Box(spacing=6)
                row.pack_start(Gtk.Label(label="%s  -  %.1f GB  -  %s" % (mnt, H.to_int(node.get("size")) / 1e9,
                                                                         node.get("fstype") or "?"), xalign=0), True, True, 0)
                rn = Gtk.Button(label=t("disks_rename"))
                rn.connect("clicked", self.rename_disk, mnt)
                dt = Gtk.Button(label=t("disks_detach"))
                dt.connect("clicked", self.detach_disk, mnt)
                for w in (rn, dt):
                    row.pack_start(w, False, False, 0)
                    self.feat_buttons.append(w)
                    if IS_LIVE:
                        w.set_sensitive(False)
                self.disks_box.pack_start(row, False, False, 0)
        self.disks_box.show_all()
        self.keep_chk.set_visible(bool(cands))

    def rename_disk(self, _btn, mnt):
        dialog = Gtk.Dialog(title=t("disks_rename"), transient_for=self, modal=True)
        dialog.add_buttons("OK", Gtk.ResponseType.OK, "Cancel" if not RU else "Отмена", Gtk.ResponseType.CANCEL)
        area = dialog.get_content_area()
        area.set_border_width(10)
        area.pack_start(Gtk.Label(label=t("disks_newname")), False, False, 4)
        entry = Gtk.Entry()
        entry.set_text(os.path.basename(mnt))
        entry.set_activates_default(True)
        area.pack_start(entry, False, False, 4)
        dialog.set_default_response(Gtk.ResponseType.OK)
        dialog.show_all()
        answer = dialog.run()
        name = entry.get_text().strip()
        dialog.destroy()
        if answer == Gtk.ResponseType.OK and name and name != os.path.basename(mnt):
            self.run_helper(["disk-rename", mnt, name])

    def detach_disk(self, _btn, mnt):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   buttons=Gtk.ButtonsType.YES_NO, text=t("confirm_detach") % mnt)
        answer = dialog.run()
        dialog.destroy()
        if answer == Gtk.ResponseType.YES:
            self.run_helper(["disk-detach", mnt])

    def format_disks(self, *_):
        picked = [p for p, c in self.disk_checks.items() if c.get_active()]
        if not picked:
            self.append_log(t("disks_pick"))
            return
        keep = self.keep_chk.get_active()
        lines = []
        if keep:
            nodes = H.list_parts(self.disk_tree)
            for d in picked:
                if nodes[d].get("fstype") not in H.KEEP_FS:
                    self.append_log(t("disks_keep_bad") % d)
                    return
            lines.append(t("disks_keep_plan") % ", ".join(picked))
        else:
            plan = H.make_plan(self.disk_tree, picked)
            if plan["join"]:
                lines.append(t("disks_join") % ", ".join(plan["join"]))
            if plan["attach"]:
                lines.append(t("disks_attach") % ", ".join(plan["attach"]))
            lines += ["", t("disks_sure")]
        dialog = Gtk.MessageDialog(transient_for=self, modal=True,
                                   message_type=Gtk.MessageType.QUESTION if keep else Gtk.MessageType.WARNING,
                                   buttons=Gtk.ButtonsType.YES_NO, text="\n".join(lines))
        answer = dialog.run()
        dialog.destroy()
        if answer == Gtk.ResponseType.YES:
            args = ["disk-format", "--yes", ",".join(picked)]
            self.run_helper(args + (["--keep"] if keep else []))

    #вкладка визуал
    def build_visual_tab(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_border_width(8)
        note = Gtk.Label(label=t("vis_note"), xalign=0)
        note.set_line_wrap(True)
        box.pack_start(note, False, False, 0)
        hint = Gtk.Label(label=t("vis_hint"), xalign=0)
        hint.set_line_wrap(True)
        box.pack_start(hint, False, False, 0)
        info = Gtk.Expander(label=t("vis_info_title"))
        body = Gtk.Label(label=t("vis_info_body"), xalign=0)
        body.set_line_wrap(True)
        body.set_selectable(True)
        info.add(body)
        box.pack_start(info, False, False, 0)

        self.vis_path = None
        pick = Gtk.Box(spacing=6)
        pick.pack_start(Gtk.Label(label=t("vis_path")), False, False, 0)
        for label, folder in ((t("vis_folder_btn"), True), (t("vis_file_btn"), False)):
            btn = Gtk.Button(label=label)
            btn.connect("clicked", self.pick_visual_path, folder)
            pick.pack_start(btn, False, False, 0)
        self.vis_path_label = Gtk.Label(label="-", xalign=0)
        self.vis_path_label.set_ellipsize(Pango.EllipsizeMode.START)
        pick.pack_start(self.vis_path_label, True, True, 0)
        box.pack_start(pick, False, False, 4)

        grid = Gtk.Grid(column_spacing=8, row_spacing=4)
        self.vis_name = Gtk.Entry()
        self.vis_icon = Gtk.ComboBoxText.new_with_entry()
        for icon in ("folder-red", "folder-blue", "folder-green", "folder-yellow", "folder-orange", "folder-violet",
                     "folder-brown", "folder-grey", "folder-black", "folder-games", "folder-download",
                     "folder-documents", "folder-music", "folder-video", "folder-pictures", "folder-favorites",
                     "folder-important", "folder-cloud"):
            self.vis_icon.append_text(icon)
        self.vis_comment = Gtk.Entry()
        self.vis_tags = Gtk.Entry()
        self.vis_rating = Gtk.SpinButton.new_with_range(0, 5, 1)
        rows = ((t("vis_name"), self.vis_name), (t("vis_icon"), self.vis_icon), (t("vis_comment"), self.vis_comment),
                (t("vis_tags"), self.vis_tags), (t("vis_rating"), self.vis_rating))
        for i, (label, widget) in enumerate(rows):
            grid.attach(Gtk.Label(label=label, xalign=0), 0, i, 1, 1)
            widget.set_hexpand(True)
            grid.attach(widget, 1, i, 1, 1)
        box.pack_start(grid, False, False, 0)
        bar = Gtk.Box(spacing=6)
        ok = Gtk.Button(label=t("vis_apply"))
        ok.connect("clicked", self.apply_visual)
        undo = Gtk.Button(label=t("vis_revert"))
        undo.connect("clicked", self.revert_visual)
        bar.pack_start(ok, False, False, 0)
        bar.pack_start(undo, False, False, 0)
        box.pack_start(bar, False, False, 0)

        ptitle = Gtk.Label(xalign=0)
        ptitle.set_markup("<b>%s</b>" % GLib.markup_escape_text(t("vis_places")))
        box.pack_start(ptitle, False, False, 8)
        prow = Gtk.Box(spacing=6)
        self.places_label = Gtk.Entry()
        self.places_label.set_placeholder_text(t("vis_places_label"))
        self.places_icon = Gtk.ComboBoxText.new_with_entry()
        for icon in ("drive-harddisk", "folder-games", "folder-favorites", "folder-download", "folder-documents"):
            self.places_icon.append_text(icon)
        self.places_icon.set_active(0)
        padd = Gtk.Button(label=t("vis_places_add"))
        padd.connect("clicked", self.add_place)
        prow.pack_start(self.places_label, True, True, 0)
        prow.pack_start(self.places_icon, False, False, 0)
        prow.pack_start(padd, False, False, 0)
        box.pack_start(prow, False, False, 0)

        ctitle = Gtk.Label(xalign=0)
        ctitle.set_markup("<b>%s</b>" % GLib.markup_escape_text(t("vis_cursor")))
        box.pack_start(ctitle, False, False, 8)
        crow = Gtk.Box(spacing=6)
        for size in (16, 20, 24, 28, 32, 36, 40, 48):
            btn = Gtk.Button(label=str(size))
            btn.connect("clicked", self.set_cursor_size, size)
            crow.pack_start(btn, False, False, 0)
        box.pack_start(crow, False, False, 0)

        reset = Gtk.Button(label=t("vis_reset_all"))
        reset.connect("clicked", self.reset_all_visual)
        box.pack_end(reset, False, False, 0)
        return box

    def pick_visual_path(self, _btn, folder):
        action = Gtk.FileChooserAction.SELECT_FOLDER if folder else Gtk.FileChooserAction.OPEN
        dialog = Gtk.FileChooserDialog(title=t("vis_path"), transient_for=self, action=action)
        dialog.add_buttons("Cancel" if not RU else "Отмена", Gtk.ResponseType.CANCEL, "OK", Gtk.ResponseType.OK)
        if dialog.run() == Gtk.ResponseType.OK:
            self.vis_path = dialog.get_filename()
            self.vis_path_label.set_text(self.vis_path)
            isdir = os.path.isdir(self.vis_path)
            keys = dir_read_keys(self.vis_path) if isdir else {}
            self.vis_name.set_sensitive(isdir)
            self.vis_icon.set_sensitive(isdir)
            self.vis_name.set_text(keys.get("Name") or os.path.basename(self.vis_path))
            self.vis_icon.get_child().set_text(keys.get("Icon") or "")
            self.vis_comment.set_text(xattr_get(self.vis_path, "user.xdg.comment") or "")
            self.vis_tags.set_text(xattr_get(self.vis_path, "user.xdg.tags") or "")
            try:
                self.vis_rating.set_value(int(xattr_get(self.vis_path, "user.baloo.rating") or 0) // 2)
            except ValueError:
                self.vis_rating.set_value(0)
        dialog.destroy()

    def apply_visual(self, *_):
        if not self.vis_path:
            self.append_log(t("vis_nofolder"))
            return
        db = vis_load()
        path = self.vis_path
        try:
            if os.path.isdir(path):
                entry = db["folders"].setdefault(path, dir_read_keys(path, ("Name", "Icon")))
                name = self.vis_name.get_text().replace("\n", " ").strip()
                icon = self.vis_icon.get_child().get_text().strip()
                dir_write_keys(path, {"Name": name if name and name != os.path.basename(path) else None,
                                      "Icon": icon or None})
        except OSError as e:
            self.append_log(t("vis_fail") % e)
            return
        try:
            saved = db["xattrs"].setdefault(path, {})
            for attr, value in (("user.xdg.comment", self.vis_comment.get_text().strip()),
                                ("user.xdg.tags", self.vis_tags.get_text().strip()),
                                ("user.baloo.rating", str(int(self.vis_rating.get_value()) * 2)
                                 if self.vis_rating.get_value() else "")):
                saved.setdefault(attr, xattr_get(path, attr))
                xattr_set(path, attr, value or None)
        except OSError as e:
            self.append_log(t("vis_xattr_fail") % e)
        vis_save(db)
        self.append_log(t("vis_done"))

    def revert_visual(self, *_):
        if not self.vis_path:
            self.append_log(t("vis_nofolder"))
            return
        db = vis_load()
        vis_restore(db, self.vis_path)
        vis_save(db)
        self.append_log(t("vis_done"))

    def add_place(self, *_):
        folder = self.vis_path if self.vis_path and os.path.isdir(self.vis_path) else None
        label = self.places_label.get_text().strip()
        if not folder:
            self.append_log(t("vis_nofolder"))
            return
        if not places_add(folder, label or os.path.basename(folder), self.places_icon.get_child().get_text().strip() or "folder"):
            self.append_log(t("vis_places_none"))
            return
        self.append_log(t("vis_done"))

    def reset_all_visual(self, *_):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   buttons=Gtk.ButtonsType.YES_NO, text=t("vis_reset_ask"))
        answer = dialog.run()
        dialog.destroy()
        if answer != Gtk.ResponseType.YES:
            return
        db = vis_load()
        for path in list(db["folders"]) + list(db["xattrs"]):
            vis_restore(db, path)
        places_clear()
        vis_save(db)
        self.set_cursor_size(None, 24)
        self.append_log(t("vis_reset_done"))

    def set_cursor_size(self, _btn, size):
        def out(cmd):
            try:
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
            except (OSError, subprocess.TimeoutExpired) as e:
                return -1, str(e)
            return r.returncode, (r.stdout + r.stderr).strip()
        rc, theme = out(["kreadconfig6", "--file", "kcminputrc", "--group", "Mouse", "--key", "cursorTheme"])
        theme = theme if rc == 0 and theme else "Lucix-Cursor"
        out(["kwriteconfig6", "--file", "kcminputrc", "--group", "Mouse", "--key", "cursorSize", str(size)])
        rc, text = out(["plasma-apply-cursortheme", "--size", str(size), theme])
        self.append_log("%s: %d (%s) -> %s %s" % (t("vis_cursor"), size, theme, "OK" if rc == 0 else "ERROR", text[-300:]))

    #вкладка система
    def build_system_tab(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(8)
        box.pack_start(Gtk.Label(label=t("sys_info"), xalign=0), False, False, 0)
        self.sys_label = Gtk.Label(xalign=0)
        box.pack_start(self.sys_label, False, False, 0)
        check = Gtk.Button(label=t("sys_check"))
        check.connect("clicked", self.check_system)
        upgrade = Gtk.Button(label=t("sys_upgrade"))
        upgrade.connect("clicked", lambda *_: self.run_helper(["apt-upgrade"]))
        box.pack_start(check, False, False, 0)
        box.pack_start(upgrade, False, False, 0)
        self.busy_widgets += [check, upgrade]
        if IS_LIVE:
            self.live_locked.append(upgrade)
            upgrade.set_sensitive(False)
        return box

    #вкладка драйверы
    def build_drivers_tab(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(8)
        box.pack_start(Gtk.Label(label=t("drv_info"), xalign=0), False, False, 0)
        self.drv_view = Gtk.TextView()
        self.drv_view.set_editable(False)
        self.drv_view.set_monospace(True)
        scroll = Gtk.ScrolledWindow()
        scroll.set_min_content_height(160)
        scroll.add(self.drv_view)
        box.pack_start(scroll, True, True, 0)
        scan = Gtk.Button(label=t("drv_scan"))
        scan.connect("clicked", lambda *_: self.run_helper(["drivers-scan"]))
        box.pack_start(scan, False, False, 0)
        btn = Gtk.Button(label=t("drv_install"))
        btn.connect("clicked", lambda *_: self.run_helper(["drivers-install"]))
        box.pack_start(btn, False, False, 0)
        self.busy_widgets += [scan, btn]
        if IS_LIVE:
            self.live_locked.append(btn)
            btn.set_sensitive(False)
        return box

    #журнал
    def append_log(self, text):
        buf = self.log.get_buffer()
        buf.insert(buf.get_end_iter(), text if text.endswith("\n") else text + "\n")
        self.log.scroll_to_mark(buf.get_insert(), 0, False, 0, 0)
        mark = buf.create_mark(None, buf.get_end_iter(), False)
        self.log.scroll_to_mark(mark, 0, False, 0, 0)

    def set_busy(self, busy):
        for w in self.busy_widgets:
            w.set_sensitive(not busy and w not in self.live_locked)
        for w in self.feat_buttons:
            w.set_sensitive(not busy and not IS_LIVE)

    def refresh_installed(self):
        self.installed = installed_version()
        self.installed_label.set_text(t("installed") % (self.installed or "?"))

    #проверка релизов
    def check_lucix(self):
        self.status_label.set_text(t("checking"))

        def worker():
            try:
                rels = fetch_releases()
                error = None
            except Exception as e:
                rels, error = [], str(e)
            GLib.idle_add(self.show_releases, rels, error)

        threading.Thread(target=worker, daemon=True).start()

    def show_releases(self, rels, error):
        self.store.clear()
        self.releases = []
        self.notes.get_buffer().set_text("")
        if error:
            self.status_label.set_text(t("net_error") % error)
            return
        show_test = self.test_check.get_active()
        for rel in rels:
            if rel.get("prerelease") and not show_test:
                continue
            tag = rel["tag_name"]
            if not is_newer(deb_version(tag), self.installed):
                continue
            self.releases.append(rel)
            kind = t("test") if rel.get("prerelease") else t("stable")
            self.store.append([tag, (rel.get("published_at") or "")[:10], kind])
        if self.releases:
            self.status_label.set_text(t("found") % len(self.releases))
            self.tree.set_cursor(0)
        else:
            self.status_label.set_text(t("uptodate"))
        self.install_btn.set_sensitive(bool(self.releases))

    def selected_tag(self):
        model, it = self.tree.get_selection().get_selected()
        return model[it][0] if it else None

    def on_select(self, selection):
        tag = self.selected_tag()
        for rel in self.releases:
            if rel["tag_name"] == tag:
                self.notes.get_buffer().set_text(rel.get("body") or rel.get("name") or tag)

    def install_selected(self, *_):
        tag = self.selected_tag()
        if tag:
            self.run_helper(["lucix-update", tag])

    #система
    def check_system(self, *_):
        self.set_busy(True)

        def worker():
            subprocess.call(["pkexec", HELPER, "apt-update"])
            r = subprocess.run(["apt", "list", "--upgradable"], capture_output=True, text=True)
            lines = [l for l in r.stdout.splitlines() if "/" in l]
            GLib.idle_add(self.sys_checked, len(lines))

        threading.Thread(target=worker, daemon=True).start()

    def sys_checked(self, count):
        self.set_busy(False)
        self.sys_label.set_text(t("sys_count") % count)

    #драйверы
    def load_drivers(self):
        def worker():
            try:
                r = subprocess.run(["ubuntu-drivers", "devices"], capture_output=True, text=True, timeout=60)
                out = r.stdout.strip() or t("drv_none")
            except Exception as e:
                out = str(e)
            GLib.idle_add(self.drv_view.get_buffer().set_text, out)

        threading.Thread(target=worker, daemon=True).start()

    #запуск помощника с правами
    def run_helper(self, args):
        self.set_busy(True)
        self.append_log("--- " + " ".join(args))

        def worker():
            rc = 1
            try:
                p = subprocess.Popen(["pkexec", HELPER] + args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
                for line in p.stdout:
                    GLib.idle_add(self.append_log, line.rstrip("\n"))
                rc = p.wait()
            except Exception as e:
                GLib.idle_add(self.append_log, str(e))
            GLib.idle_add(self.helper_finished, rc, args)

        threading.Thread(target=worker, daemon=True).start()

    def helper_finished(self, rc, args):
        self.set_busy(False)
        if rc == 3:
            dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING, buttons=Gtk.ButtonsType.YES_NO, text=t("no_snap_title"))
            dialog.format_secondary_text(t("no_snap_text"))
            answer = dialog.run()
            dialog.destroy()
            if answer == Gtk.ResponseType.YES:
                self.run_helper(args + ["--no-snapshot"])
            return
        if rc in (126, 127):
            self.append_log(t("auth_fail"))
            return
        self.append_log(t("finished_ok") if rc == 0 else t("finished_bad"))
        self.refresh_installed()
        if args[0] == "lucix-update":
            self.check_lucix()
        if args[0] in ("drivers-scan", "drivers-install"):
            self.load_drivers()
        if args[0] == "apps-install":
            self.refresh_apps()
        if args[0] in ("feature-apt", "grub-theme", "security"):
            self.refresh_features()
        if args[0] == "optimize-disks":
            self.refresh_memory()
        if args[0] in ("disk-format", "disk-rename", "disk-detach"):
            self.refresh_disks()
            self.refresh_memory()


if __name__ == "__main__":
    Updater()
    Gtk.main()
