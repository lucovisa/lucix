#!/usr/bin/python3
import json
import os
import subprocess
import threading
import urllib.request

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk, Pango

REPO = "lucovisa/lucix"
HELPER = "/usr/lib/lucix/lucix-helper"
SHOW_TEST_DEFAULT = True



def detect_lang():
    for var in ("LC_ALL", "LC_MESSAGES", "LANGUAGE", "LANG"):
        v = os.environ.get(var, "")
        if v and v != "C":
            return v.split(":")[0].split(".")[0].split("@")[0]
    return ""


LANGCODE = detect_lang()
RU = LANGCODE.startswith("ru")


def app_title():
    """название окна на языке системы: берём из desktop-файла (там переводы на много языков)"""
    names = {}
    try:
        with open("/usr/share/applications/lucix-update.desktop", encoding="utf-8") as f:
            for line in f:
                if line.startswith("Name"):
                    key, _, val = line.partition("=")
                    names[key[4:].strip("[]") if key != "Name" else ""] = val.strip()
    except OSError:
        pass
    for code in (LANGCODE, LANGCODE.split("_")[0]):
        if code and code in names:
            return names[code]
    return names.get("", "Lucix Features")


def is_live():
    try:
        with open("/proc/cmdline") as f:
            return "boot=casper" in f.read()
    except Exception:
        return False


IS_LIVE = is_live()

