GRUB_THEME_DIR = "/boot/grub/themes/minegrub-world-selection"
GRUB_THEME_REPO = "Lxtharia/minegrub-world-sel-theme"
GRUB_FULL = """# Lucix: тема GRUB и показ Windows в меню (читается последней, поэтому другие настройки её не перебьют)
