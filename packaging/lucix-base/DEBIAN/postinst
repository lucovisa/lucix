#!/bin/sh
set -e

case "$1" in
configure)
  VER="$(dpkg-query -W -f='${Version}' lucix-base 2>/dev/null || echo unknown)"

  #версия системы
  printf 'NAME=Lucix\nVERSION=%s\nSTAGE=pre-release\n' "$VER" > /etc/lucix-release

  #имя и значок в os-release
  osr=/usr/lib/os-release
  if [ -f "$osr" ] && [ ! -L "$osr" ]; then
    setkv() {
      if grep -q "^$1=" "$osr"; then
        sed -i "s|^$1=.*|$1=$2|" "$osr"
      else
        echo "$1=$2" >> "$osr"
      fi
    }
    setkv NAME '"Lucix"'
    setkv ID lucix
    setkv ID_LIKE '"ubuntu debian"'
    setkv PRETTY_NAME "\"Lucix $VER\""
    setkv LOGO lucix
  fi

  #заставка
  theme=/usr/share/plymouth/themes/lucix/lucix.plymouth
  if command -v update-alternatives >/dev/null 2>&1; then
    update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth "$theme" 300 || true
    update-alternatives --set default.plymouth "$theme" || true
  fi
  conf=/etc/plymouth/plymouthd.conf
  mkdir -p /etc/plymouth
  if [ ! -f "$conf" ]; then
    printf '[Daemon]\nTheme=lucix\nShowDelay=0\n' > "$conf"
  elif grep -q '^Theme=' "$conf"; then
    sed -i 's/^Theme=.*/Theme=lucix/' "$conf"
  elif grep -q '^\[Daemon\]' "$conf"; then
    sed -i '/^\[Daemon\]/a Theme=lucix' "$conf"
  else
    printf '\n[Daemon]\nTheme=lucix\n' >> "$conf"
  fi

  #меню Пуск и всплывающие окна без прозрачности: берём сплошной фон из стандартной темы Plasma
  solid=/usr/share/plasma/desktoptheme/default/solid/dialogs/background.svgz
  if [ -f "$solid" ] && [ -d /usr/share/plasma/desktoptheme/Lucix ]; then
    mkdir -p /usr/share/plasma/desktoptheme/Lucix/translucent/dialogs
    cp -f "$solid" /usr/share/plasma/desktoptheme/Lucix/translucent/dialogs/background.svgz || true
  fi

  #курсор Lucix как системный: по умолчанию для всех программ, экрана входа и GTK
  if [ -d /usr/share/icons/Lucix-Cursor ]; then
    mkdir -p /usr/share/icons/default /etc/sddm.conf.d /etc/gtk-3.0 /etc/gtk-4.0
    printf '[Icon Theme]\nName=Default\nInherits=Lucix-Cursor\n' > /usr/share/icons/default/index.theme
    mkdir -p /etc/xdg
    printf '[Mouse]\ncursorTheme=Lucix-Cursor\ncursorSize=24\n' > /etc/xdg/kcminputrc
    for g in gtk-3.0 gtk-4.0; do
      printf '[Settings]\ngtk-cursor-theme-name=Lucix-Cursor\ngtk-cursor-theme-size=24\n' > /etc/$g/settings.ini
    done
  fi

  #безопасность по умолчанию: один раз включаем, дальше выбор пользователя (переключатели в «Функциях Lucix»)
  if [ ! -f /var/lib/lucix/security-defaults ]; then
    mkdir -p /var/lib/lucix
    printf 'APT::Periodic::Update-Package-Lists "1";\nAPT::Periodic::Unattended-Upgrade "1";\nUnattended-Upgrade::Automatic-Reboot "false";\nUnattended-Upgrade::Remove-Unused-Dependencies "false";\n' > /etc/apt/apt.conf.d/52lucix-auto-security
    if command -v ufw >/dev/null 2>&1; then
      ufw default deny incoming >/dev/null 2>&1 || true
      ufw default allow outgoing >/dev/null 2>&1 || true
      ufw --force enable >/dev/null 2>&1 || true
    fi
    systemctl enable apparmor >/dev/null 2>&1 || true
    : > /var/lib/lucix/security-defaults
  fi

  #экран входа: обои Lucix вместо стандартных (тема breeze читает theme.conf.user)
  if [ -d /usr/share/sddm/themes/breeze ] && [ -f /usr/share/backgrounds/lucix/lucix.jpg ]; then
    mkdir -p /etc/sddm.conf.d
    rm -f /etc/sddm.conf.d/10-lucix-cursor.conf /etc/sddm.conf.d/11-lucix-theme.conf
    #имя начинается с zz, чтобы наши настройки читались последними и не перебивались чужими (например kde_settings.conf)
    printf '[Theme]\nCurrent=breeze\nCursorTheme=Lucix-Cursor\nCursorSize=24\n' > /etc/sddm.conf.d/zz-lucix.conf
    #если есть общий файл /etc/sddm.conf, правим и его
    if [ -f /etc/sddm.conf ] && command -v kwriteconfig6 >/dev/null 2>&1; then
      kwriteconfig6 --file /etc/sddm.conf --group Theme --key Current breeze || true
      kwriteconfig6 --file /etc/sddm.conf --group Theme --key CursorTheme Lucix-Cursor || true
    fi
    printf '[General]\ntype=image\nbackground=/usr/share/backgrounds/lucix/lucix.jpg\n' > /usr/share/sddm/themes/breeze/theme.conf.user
  fi

  #кэш иконок
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor || true
  fi

  #initramfs на сборке образа обновляет сам скрипт сборки
  if [ -z "$LUCIX_BUILD" ] && command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u || true
  fi
  ;;
esac

exit 0
