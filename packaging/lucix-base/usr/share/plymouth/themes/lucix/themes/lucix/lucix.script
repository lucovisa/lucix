#фон
Window.SetBackgroundTopColor(0.078, 0.086, 0.11);
Window.SetBackgroundBottomColor(0.078, 0.086, 0.11);

#кадры вращения по часовой стрелке
frames = 72;
for (i = 0; i < frames; i++) frame[i] = Image("f" + i + ".png");
logo.sprite = Sprite(frame[0]);
logo.sprite.SetPosition(Window.GetWidth() / 2 - frame[0].GetWidth() / 2, Window.GetHeight() / 2 - frame[0].GetHeight() / 2, 1);
tick = 0;

#подсказка про enter
hint.image = Image("hint.png");
hint.sprite = Sprite(hint.image);
hint.sprite.SetPosition(Window.GetWidth() / 2 - hint.image.GetWidth() / 2, Window.GetHeight() * 0.8, 20);
hint.sprite.SetOpacity(0);

#вращение и подсказка при выключении
fun refresh_callback() {
  tick++;
  logo.sprite.SetImage(frame[Math.Int(tick / 3) % frames]);
  if (Plymouth.GetMode() == "shutdown" && tick > 300) hint.sprite.SetOpacity(1);
}
Plymouth.SetRefreshFunction(refresh_callback);

#пароль диска
pass_prompt = Sprite();
pass_bullets = Sprite();

fun display_password(prompt, bullets) {
  img = Image.Text(prompt, 1, 1, 1);
  pass_prompt.SetImage(img);
  pass_prompt.SetPosition(Window.GetWidth() / 2 - img.GetWidth() / 2, Window.GetHeight() * 0.78, 10);
  pass_prompt.SetOpacity(1);
  if (bullets > 0) {
    stars = "";
    for (i = 0; i < bullets; i++) stars += "*";
    b = Image.Text(stars, 1, 1, 1);
    pass_bullets.SetImage(b);
    pass_bullets.SetPosition(Window.GetWidth() / 2 - b.GetWidth() / 2, Window.GetHeight() * 0.78 + 36, 10);
    pass_bullets.SetOpacity(1);
  } else {
    pass_bullets.SetOpacity(0);
  }
}

#вопрос системы например достаньте флешку и нажмите enter
fun display_question(prompt, entry) {
  hint.sprite.SetOpacity(1);
}

fun display_normal() {
  pass_prompt.SetOpacity(0);
  pass_bullets.SetOpacity(0);
  hint.sprite.SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayQuestionFunction(display_question);
Plymouth.SetDisplayNormalFunction(display_normal);
